{
  "experiment_name": "Experiment 4: Integrated Scenario - Proposed Full (SSP + UDP + FEC + Adaptive Compression)",
  "epochs": {
    "self": 64,
    "wafl": 2048
  },
  "contact_pattern": "sumo_real/contact_pattern_mobility.json",
  "wafl_phase": {
    "aggregation_strategy": "FedAvg",
    "batch_size": 32,
    "learning_rate": 0.001,
    "coefficiency": 1.0
  },
  "network_condition": {
    "enabled": false
  },
  "mobility_aware": {
    "enabled": true,
    "contact_pattern_file": "sumo_real/contact_pattern_mobility.json",
    "network_conditions_file": "sumo_real/network_conditions_mobility.json",
    "path_loss_model_file": "sumo/path_loss_model.json"
  },
  "method": {
    "ssp": {
      "enabled": true,
      "ssp_threshold": 0.9
    },
    "udp": {
      "enabled": true,
      "fec_m": "auto",
      "timeouts": {
        "initial_packet": 2.0,
        "inter_packet": 0.2,
        "model_completion": 15.0
      }
    },
    "compression": {
      "enabled": true,
      "initial_method": "zlib"
    },
    "model_fetch_timeout": 15.0
  }
}